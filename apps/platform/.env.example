# The platform admin app. Copy to .env.local for `npm run dev:platform`.

# Sample data, no backend.
NEXT_PUBLIC_USE_MOCK=true

# Live mode only (NEXT_PUBLIC_USE_MOCK unset or "false"):
# How the server reaches core: http (default) or nats (docs/adr/0005).
# BACKEND_TRANSPORT=http
# http only: MHAI API base, without /api/v1, and the BFF service key file
# (X-MHAI-Service; a file, never the key itself).
# MHAI_API_URL=http://localhost:8000
# BFF_SERVICE_KEY_FILE=
# nats only: the server, and this app's NKey seed as a mounted file
# (never in the environment). Outside development: a tls:// URL and the
# three TLS files are required.
# NATS_URL=nats://localhost:4222
# NATS_NKEY_SEED_FILE=/run/secrets/nats-bff-platform.nk
# NATS_TLS_CA_FILE=
# NATS_TLS_CERT_FILE=
# NATS_TLS_KEY_FILE=
# development only: a password user instead of an NKey (the backend's dev stack).
# NATS_USER=bff_platform
# NATS_PASSWORD_FILE=
# MHAI_DEPLOY_ENV=development
# Both: the header the host's nginx overwrites with the user's IP (X-Real-IP).
# TRUSTED_CLIENT_IP_HEADER=x-real-ip
# Refresh the session when its token has less than this left (seconds,
# 1–3600; default 300). The live e2e sets it above the token's lifetime.
# SESSION_REFRESH_WITHIN_S=300
# Seals the session cookie. At least 32 characters: openssl rand -base64 48
# PLATFORM_SESSION_SECRET=

# Analysis across hospitals stays off until it is signed off: only the exact
# value "true" turns it on. Leave both unset until then. The server keeps its
# own switches; these can only keep the page dark, never turn it on.
# ANALYSIS_SIGNED_OFF=
# ANALYSIS_PATIENT_VIEWS_SIGNED_OFF=
