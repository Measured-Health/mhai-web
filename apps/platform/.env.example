# The platform admin app. Copy to .env.local for `npm run dev:platform`.

# Sample data, no backend.
NEXT_PUBLIC_USE_MOCK=true

# Live mode only (NEXT_PUBLIC_USE_MOCK unset or "false"):
# MHAI API base, without /api/v1.
# MHAI_API_URL=http://localhost:8000
# Seals the session cookie. At least 32 characters: openssl rand -base64 48
# PLATFORM_SESSION_SECRET=

# Analysis across hospitals stays off until it is signed off: only the exact
# value "true" turns it on. Leave both unset until then. The server keeps its
# own switches; these can only keep the page dark, never turn it on.
# ANALYSIS_SIGNED_OFF=
# ANALYSIS_PATIENT_VIEWS_SIGNED_OFF=
