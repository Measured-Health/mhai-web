# Plan 1 runs on mock data only.
NEXT_PUBLIC_USE_MOCK=true

# Live mode only (NEXT_PUBLIC_USE_MOCK unset or "false"):
# MHAI API base, without /api/v1.
# MHAI_API_URL=http://localhost:8000
# Seals the session cookie. At least 32 characters: openssl rand -base64 48
# SESSION_SECRET=
# Analysis stays off in live mode until its sign-off; then set this to true
# (see "### Analysis" in the README).
# ANALYSIS_SIGNED_OFF=
# Named access stays off until clinical, privacy and legal sign-off; then true.
# NAMED_ACCESS_SIGNED_OFF=
